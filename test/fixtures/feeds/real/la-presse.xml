                            <enclosure
                                        length="184229"                     type="image/jpeg"                     url="https://mobile-img.lpcdn.ca/v2/924x/r3996/ec942313f1cb3dd5830034acbfe4badb.jpg"
                />
            
            <link>https://www.lapresse.ca/actualites/sciences/2026-10-05/prix-nobel-de-medecine/un-trio-americano-allemand-recompense-pour-des-travaux-sur-les-mysteres-du-cerveau.php?utm_source=rss&amp;utm_medium=fil&amp;utm_campaign=actualites</link>            <guid isPermaLink="false">4c04b7439a7536788684843e518c9e1d</guid>
